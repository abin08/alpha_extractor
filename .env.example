# Gemini AI Configuration
GEMINI_API_KEY=your_google_genai_api_key_here
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# Postgres Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=alpha_extractor
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis / Celery Broker
REDIS_URL=redis://localhost:6379/0

# External Integrations
UNG_API_URL=http://localhost:8000/notify
UNG_API_KEY=your_unified_notification_gateway_key

AMFI_URL="https://www.amfiindia.com/spages/NAVAll.txt"
RSS_URLS='["https://www.moneycontrol.com/rss/business.xml", "https://www.livemint.com/rss/markets"]'
SCREENER_BASE_URL="https://www.screener.in/company/"

# S3 / MinIO Storage Configuration
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="you_s3_secret_key"
S3_BUCKET_NAME="alpha-extractor-raw"

# Scheduler Configuration (IST)
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
